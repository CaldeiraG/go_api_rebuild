    "/scrap/insertTicket": {
      "get": {
        "tags": ["Scrap"],
        "summary": "Insert a scrap ticket",
        "operationId": "insertScrapTicket",
        "parameters": [
          {"name": "ticket", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "date", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "price", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "costcenter", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Ticket inserted"},
          "400": {"description": "Missing required parameter: ticket"},
          "500": {"description": "Internal error"}
        }
      }
    },
