    "/graph/api/hourly/{line_id}": {
      "get": {
        "tags": ["Graph"],
        "summary": "Get hourly production data",
        "description": "Get hourly production data for a line within a date range. Returns production by hour and shift.",
        "operationId": "getHourlyProduction",
        "parameters": [
          {
            "name": "line_id",
            "in": "path",
            "description": "Line ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Start date (YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "End date (YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {"$ref": "#/components/parameters/Model"}
        ],
        "responses": {
          "200": {
            "description": "Hourly production data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "line_id": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "hora": {
                        "type": "integer"
                      },
                      "prod": {
                        "type": "integer"
                      },
                      "shift": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string",
                        "description": "Per-row error when a query or scan fails"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No data found for the specified line and date range"
          }
        }
      }
    },
